# WordPress site base URL (no trailing slash)
# Example: https://example.com
WORDPRESS_BASE_URL=

# Optional: if WP REST API requires Basic Auth (not recommended for public)
# WORDPRESS_BASIC_AUTH_USER=
# WORDPRESS_BASIC_AUTH_PASS=

# Optional: enable fetching draft/private content (requires auth)
# WORDPRESS_INCLUDE_DRAFTS=false

# The canonical site URL is fixed in src/lib/site-url.ts (https://www.bakamosocial.com).

# Google Analytics 4 measurement ID. Production builds default to G-L84VKCB2WZ;
# set to an empty value to disable. Development builds never load analytics.
# NEXT_PUBLIC_GA_ID=G-L84VKCB2WZ
