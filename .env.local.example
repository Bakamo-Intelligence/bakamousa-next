# Set your WordPress base URL (no trailing slash)
WORDPRESS_BASE_URL=https://bakamosocial.com

# Optional: Basic Auth (Application Passwords) to fetch drafts or protected content
# WORDPRESS_BASIC_AUTH_USER=your-wp-username
# WORDPRESS_BASIC_AUTH_PASS=your-application-password

# Preview secret for /api/preview — set a long random value and keep it secret
# WP_PREVIEW_SECRET=some-long-random-secret

# Optional: only fetch posts in this category ID (set after creating a category/tag for Bakamo USA in WP)
# WORDPRESS_POST_CATEGORY_ID=123

# Usage (example):
# 1) Create an Application Password in WP admin (optional, only needed to fetch drafts).
# 2) Set WORDPRESS_BASE_URL and OPTIONAL Basic Auth above.
# 3) Set WP_PREVIEW_SECRET and then open:
#    https://your-next-site.com/api/preview?secret=<WP_PREVIEW_SECRET>&slug=<post-or-page-slug>
# To exit preview mode, visit: /api/exit-preview

# The canonical site URL is fixed in src/lib/site-url.ts (https://www.bakamosocial.com).
# Analytics (GA4) only loads in production builds; see .env.example.
